     "case_name": "Church of the Lukumi Babalu Aye, Inc. v. City of Hialeah",
     "case_name_full": "CHURCH OF THE LUKUMI BABALU AYE, INC., Et Al. v. CITY OF HIALEAH",
     "scdb_id": "1992-093",
     "scdb_decision_direction": 2,
     "scdb_votes_majority": 9,
     "scdb_votes_minority": 0,
     "source": "LRU",
     "procedural_history": "",
     "attorneys": "Douglas Laycock argued the cause for petitioners. With him on the briefs were Jeanne Baker, Steven R. Shapiro, and Jorge A. Duarte., Richard G. Garrett argued the cause for respondent. With him on the brief were Stuart H. Singer and Steven M. Goldsmith.*",
     "nature_of_suit": "",
     "posture": "",
     "syllabus": "",
     "headnotes": "",
     "summary": "",
