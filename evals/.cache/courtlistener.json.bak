     "filepath_pdf_scan": null,
     "arguments": "",
     "headmatter": "<parties id=\"b325-4\">\n    UNITED STATES\n    <em>\n     v.\n    </em>\n    VERDUGO-URQUIDEZ\n   </parties><br><docketnumber id=\"b325-6\">\n    No. 88-1353.\n   </docketnumber><otherdate id=\"AoA\">\n    Argued November 7, 1989\n   </otherdate><decisiondate id=\"AzX\">\n    Decided February 28, 1990\n   </decisiondate><br><judges id=\"b327-6\">\n<span citation-index=\"1\" class=\"star-pagination\" label=\"261\"> \n     *261\n     </span>\n    Rehnquist, C. J., delivered the opinion of the Court, in which White, O\u2019Connor, Scalia, and Kennedy, JJ., joined. Kennedy, J., filed a concurring opinion,\n    <em>\n     post,\n    </em>\n    p. 275. Stevens, J., filed an opinion concurring in the judgment,\n    <em>\n     post,\n    </em>\n    p. 279. Brennan, J., filed a dissenting opinion, in which Marshall, J., joined,\n    <em>\n     post,\n    </em>\n    p. 279. Blackmun, J., filed a dissenting opinion,\n    <em>\n     post,\n    </em>\n    p. 297.\n   </judges><br><attorneys id=\"b327-7\">\n<em>\n     Lawrence S. Robbins\n    </em>\n    argued the cause for the United States. With him on the briefs were\n    <em>\n     Solicitor General Starr, Assistant Attorney General Dennis,\n    </em>\n    and\n    <em>\n     Deputy Solicitor General Bryson.\n    </em>\n</attorneys><br><attorneys id=\"b327-8\">\n<em>\n     Michael Pancer\n    </em>\n    argued the cause for respondent. With him on the brief were\n    <em>\n     Charles L. Goldberg\n    </em>\n    and\n    <em>\n     Patrick Q. Hall.\n    </em>\n<a class=\"footnote\" href=\"#fn*\" id=\"fn*_ref\">\n<em>\n      *\n     </em>\n</a>\n</attorneys><div class=\"footnotes\"><div class=\"footnote\" id=\"fn*\" label=\"*\">\n<a class=\"footnote\" href=\"#fn*_ref\">\n     *\n    </a>\n<p id=\"b327-11\">\n<em>\n      Kent S. Scheidegger\n     </em>\n     filed a brief for the Criminal Justice Legal Foundation as\n     <em>\n      amicus curiae\n     </em>\n     urging reversal.\n    </p>\n<p id=\"b327-12\">\n<em>\n      John A. Powell, Paul L. Hoffman,\n     </em>\n     and\n     <em>\n      David D. Cole\n     </em>\n     filed a brief for the American Civil Liberties Union et al. as\n     <em>\n      amici curiae\n     </em>\n     urging affirmance.\n    </p>\n</div></div>"
    }
   ]
