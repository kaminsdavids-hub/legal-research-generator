# ---------------------------------------------------------------------------
# legal research generator — local configuration
# Copy to .env and edit. No cloud LLMs: every endpoint below is local.
# ---------------------------------------------------------------------------

# Backend server
LRG_HOST=127.0.0.1
LRG_PORT=8000

# LLM backend mode: "mock" (deterministic, no GPU/network) or "openai" (local
# OpenAI-compatible server such as Ollama / vLLM / llama.cpp on the Spark).
LRG_LLM_MODE=openai

# OpenAI-compatible endpoints (used only when LRG_LLM_MODE=openai).
# Example: all expert roles routed through a local Ollama instance.
LRG_ROUTER_BASE_URL=http://127.0.0.1:11434/v1
LRG_ROUTER_MODEL=llama3.1:8b

LRG_SAUL_BASE_URL=http://127.0.0.1:11434/v1
# SaulLM-7B (Equall/Saul-7B-Instruct-v1) served via Ollama. Install with:
#   ollama pull hf.co/mradermacher/Saul-7B-Instruct-v1-GGUF:Q5_K_M
#   ollama cp   hf.co/mradermacher/Saul-7B-Instruct-v1-GGUF:Q5_K_M saul:7b-instruct-v1
LRG_SAUL_MODEL=saul:7b-instruct-v1

LRG_FINANCE_BASE_URL=http://127.0.0.1:11434/v1
LRG_FINANCE_MODEL=llama3.1:8b

LRG_WRITER_BASE_URL=http://127.0.0.1:11434/v1
LRG_WRITER_MODEL=qwen2.5-coder:7b

# Local API key for the OpenAI-compatible servers (most local servers ignore it).
LRG_LLM_API_KEY=local-not-secret

# Retrieval: "mock" (in-memory keyword+lexical, no deps) or "faiss".
LRG_RETRIEVER_MODE=mock
LRG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Build this with `lrg-ingest` from CourtListener / CAP / USC / CFR / your uploads.
LRG_CORPUS_PATH=data/corpus/sample_corpus.jsonl

# Verifier support test — does a source actually support the proposition?
#   lexical   (default; deterministic, no deps)
#   embedding (sentence-transformers cosine; needs the gpu extra)
#   nli       (cross-encoder entailment P(passage ⊨ claim); needs the gpu extra)
# The semantic options fall back to lexical if their deps are missing.
LRG_SUPPORT_SCORER=lexical
# LRG_SUPPORT_THRESHOLD=0.55
LRG_NLI_MODEL=cross-encoder/nli-deberta-v3-base
# On the Spark, for real semantic verification:
#   LRG_SUPPORT_SCORER=nli
#   LRG_RETRIEVER_MODE=faiss

# PDF renderer: "html" (deterministic HTML/PDF) or "latex" (tectonic/latexmk).
LRG_PDF_RENDERER=html

# Citation style: bluebook | alwd | oscola
LRG_CITATION_STYLE=bluebook
