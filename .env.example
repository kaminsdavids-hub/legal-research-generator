# ---------------------------------------------------------------------------
# legal research generator — local configuration
# Copy to .env and edit. Every endpoint below is local except the two hosted
# providers at the bottom, which are opt-in and disabled by default.
# ---------------------------------------------------------------------------

# Backend server
LRG_HOST=127.0.0.1
LRG_PORT=8000
# Optional debug/ops endpoints (e.g., retrieval smoke test). Keep false unless
# you explicitly want those routes exposed.
LRG_DEBUG_ENDPOINTS_ENABLED=false
# JSON array of allowed browser origins for cross-origin API calls.
# Include your deployed frontend origin(s) in production.
LRG_CORS_ORIGINS=["http://localhost:3000","https://legal-research-generator-app.netlify.app"]

# LLM backend mode: "mock" (deterministic, no GPU/network) or "openai" (local
# OpenAI-compatible server such as Ollama / vLLM / llama.cpp on the Spark).
LRG_LLM_MODE=openai

# OpenAI-compatible endpoints (used only when LRG_LLM_MODE=openai).
# Example: all expert roles routed through a local Ollama instance.
LRG_SAUL_BASE_URL=http://127.0.0.1:11434/v1
# SaulLM-7B (Equall/Saul-7B-Instruct-v1) served via Ollama. Install with:
#   ollama pull hf.co/mradermacher/Saul-7B-Instruct-v1-GGUF:Q5_K_M
#   ollama cp   hf.co/mradermacher/Saul-7B-Instruct-v1-GGUF:Q5_K_M saul:7b-instruct-v1
LRG_SAUL_MODEL=saul:7b-instruct-v1

LRG_WRITER_BASE_URL=http://127.0.0.1:11434/v1
LRG_WRITER_MODEL=llama3.1:8b

# Gemma 3 — the general-purpose analyst (banking/finance + synthesis substance) and
# the router's tie-break classifier. Pull with:
#   ollama pull gemma3:4b
LRG_GEMMA_BASE_URL=http://127.0.0.1:11434/v1
LRG_GEMMA_MODEL=gemma3:4b

# Hermes role — reasoning/ideation engine. Backed by NVIDIA Nemotron 3 Nano
# (strong reasoning/tool-use, ~2.8GB). Pull with:
#   ollama pull nemotron-3-nano:4b
LRG_HERMES_BASE_URL=http://127.0.0.1:11434/v1
LRG_HERMES_MODEL=nemotron-3-nano:4b

# Hermes-3 role — final grammar/fluency pass. Pull with:
#   ollama pull hermes3:8b
LRG_HERMES3_BASE_URL=http://127.0.0.1:11434/v1
LRG_HERMES3_MODEL=hermes3:8b

# Secondary chat module (Model Jury): runs a fixed panel of models and then
# verifies the synthesized answer with Gemma 3 and Saul.
LRG_MULTI_CHAT_BASE_URL=http://127.0.0.1:11434/v1
LRG_MULTI_CHAT_GPT_OSS_MODEL=gpt-oss:20b
LRG_MULTI_CHAT_GEMMA4_MODEL=gemma4:latest
LRG_MULTI_CHAT_APERTUS_MODEL=apertus:latest
LRG_MULTI_CHAT_NEMOTRON_MODEL=nemotron-3-nano:4b
LRG_MULTI_CHAT_HERMES3_MODEL=hermes3:8b
LRG_MULTI_CHAT_VERIFIER_GEMMA3_MODEL=gemma3:4b
LRG_MULTI_CHAT_VERIFIER_SAUL_MODEL=saul:7b-instruct-v1
# ---------------------------------------------------------------------------
# Ollama SERVER settings (not read by this app -- set them on the ollama
# service itself, then `sudo systemctl restart ollama`).
#
# These dominate Model Jury latency and cannot be set from the OpenAI-compatible
# endpoint. One jury query activates 8 models (5 panel + synthesis + 2
# verifiers); Ollama keeps only 3 resident by default and sizes each model's KV
# cache from available memory, so on a 128 GB Spark hermes3:8b occupies 30.4 GB
# instead of 6.0 GB. The result is constant evict/reload and timed-out panel
# members.
#
#   sudo mkdir -p /etc/systemd/system/ollama.service.d
#   sudo tee /etc/systemd/system/ollama.service.d/limits.conf <<'EOF'
#   [Service]
#   Environment="OLLAMA_MAX_LOADED_MODELS=6"
#   Environment="OLLAMA_CONTEXT_LENGTH=8192"
#   EOF
#   sudo systemctl daemon-reload && sudo systemctl restart ollama
# ---------------------------------------------------------------------------

# Keep Model Jury responsive on constrained hardware.
# The panel's effective per-model timeout is derived from whatever the total
# budget leaves after reserving time for synthesis + grounding + verifiers, so
# PER_MODEL_TIMEOUT_SECONDS acts as a ceiling rather than a guarantee.
LRG_MULTI_CHAT_MAX_LATENCY_SECONDS=120
LRG_MULTI_CHAT_PER_MODEL_TIMEOUT_SECONDS=25
# Panel members queried at once. Each concurrent model must be co-resident in
# memory, so raise this only when the host has headroom (on a full Spark with
# vLLM also running, 2 is the safe setting).
LRG_MULTI_CHAT_PANEL_CONCURRENCY=2
LRG_MULTI_CHAT_SYNTHESIS_TIMEOUT_SECONDS=20
LRG_MULTI_CHAT_PER_VERIFIER_TIMEOUT_SECONDS=15
LRG_MULTI_CHAT_RESCUE_MODEL=nemotron-3-nano:4b
LRG_MULTI_CHAT_RESCUE_TIMEOUT_SECONDS=20

# Sequential post-draft grammar correction chain (roles run left-to-right).
LRG_GRAMMAR_CHAIN_ENABLED=true
LRG_GRAMMAR_CHAIN_ROLES=hermes,gemma,hermes3
LRG_GRAMMAR_CHAIN_FAIL_OPEN=true

# Mechanism gate: no passage may rest its argument on an operation it never
# states ("the algorithm determines eligibility"). The scan is deterministic and
# free; the LLM critic costs one call per drafted section, so it is opt-in.
LRG_MECHANISM_GATE_ENABLED=true
LRG_MECHANISM_GATE_CRITIC_ENABLED=false
LRG_MECHANISM_GATE_CRITIC_ROLE=hermes
LRG_MECHANISM_GATE_REPAIR_ENABLED=true
LRG_MECHANISM_GATE_FAIL_OPEN=true
# Whether an unrepaired black-box passage makes the paper unshippable. Off by
# default; turn it on for work where the mechanism is the subject of the
# argument rather than background.
LRG_MECHANISM_GATE_BLOCKS_SHIP=false

# Keep your Socratic exchanges verbatim, so a model can later be trained on the
# way you argue. OFF by default and deliberately: this writes what you wrote
# into a file that outlives the manuscript. Both variables are required, and
# there is no default path.
# LRG_MAIEUTIC_TRAINING_CAPTURE=1
# LRG_MAIEUTIC_TRAINING_PATH=.maieutic/training.jsonl

# Dialectic lineup: four DISTINCT model families (thesis / antithesis /
# synthesis, plus a fourth for the NLI contradiction pass). Same-family debaters
# have correlated errors and produce agreement dressed as debate, so the engine
# refuses to start when two roles share one.
LRG_DIALECTIC_BASE_URL=http://127.0.0.1:11434/v1
LRG_DIALECTIC_THESIS_MODEL=saul:7b-instruct-v1
LRG_DIALECTIC_ANTITHESIS_MODEL=llama3.1:8b
LRG_DIALECTIC_SYNTHESIS_MODEL=gemma3:4b
LRG_DIALECTIC_NLI_MODEL=nemotron-3-nano:4b
# Per-role endpoint overrides, empty meaning "use LRG_DIALECTIC_BASE_URL". These
# exist for the control arm: pointing ONE role at a frontier API while the rest
# stay local is the only configuration that can say whether a weak result comes
# from the local models or from the pipeline. A role served off this machine
# must carry its own key -- it will not fall back to LRG_LLM_API_KEY, because a
# "frontier" number produced by a local model is worse than no number.
#   ./scripts/preflight_models.py --no-probe   validates a lineup for free
#   ./scripts/frontier_control.sh              runs the comparison
# LRG_DIALECTIC_THESIS_BASE_URL=https://api.anthropic.com/v1
# LRG_DIALECTIC_THESIS_API_KEY=

# Local API key for the OpenAI-compatible servers (most local servers ignore it).
LRG_LLM_API_KEY=local-not-secret

# Per-request timeout (seconds). Reasoning models (e.g. Nemotron Nano) emit
# chain-of-thought before answering and can take well over a minute on CPU/Metal.
LRG_LLM_TIMEOUT_SECONDS=300

# Preload every local Ollama model on startup with a tiny completion. This pays
# the first-load cost once and, combined with OLLAMA_MAX_LOADED_MODELS, keeps
# models resident across the pipeline and Model Jury instead of reloading.
# LRG_LLM_WARMUP_ENABLED=false
# LRG_LLM_WARMUP_PROMPT=Hello.

# Ollama server setting: how many models may stay loaded in GPU memory at once.
# Set to 0 for unlimited. Must also be exported in the Ollama server environment.
# LRG_OLLAMA_MAX_LOADED_MODELS=0

# Hosted GLM-5.2 / DeepSeek-V4-Pro. GLM-5.2 is 753B and DeepSeek-V4-Pro is 1.6T,
# so neither fits the 128GB Spark and both are reached as remote APIs. They join
# the pool as the extra roles "glm" and "deepseek" only when enabled AND keyed.
# NOTE: enabling either sends prompt text off the local machine.
#
# The unprefixed forms (GLM_API_KEY, DEEPSEEK_API_KEY, ...) are also accepted so
# one shell environment configures this and the patent-generator stack together.
LRG_GLM_ENABLE=false
LRG_GLM_BASE_URL=https://api.z.ai/api/paas/v4
LRG_GLM_MODEL=glm-5.2
LRG_GLM_API_KEY=

LRG_DEEPSEEK_ENABLE=false
LRG_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LRG_DEEPSEEK_MODEL=deepseek-v4-pro
LRG_DEEPSEEK_API_KEY=

# Optionally hand existing local roles to a hosted provider, e.g. send legal
# analysis to DeepSeek and brainstorming to GLM. Roles omitted stay local, and
# entries naming a disabled provider are ignored.
#   LRG_REMOTE_ROLE_MAP=saul=deepseek,writer=glm
LRG_REMOTE_ROLE_MAP=

# Retrieval: "mock" (in-memory keyword+lexical, no deps) or "faiss".
LRG_RETRIEVER_MODE=faiss
LRG_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
# Build this with `lrg-ingest` from CourtListener / CAP / USC / CFR / your uploads.
LRG_CORPUS_PATH=data/corpus/sample_corpus.jsonl

# Verifier support test — does a source actually support the proposition?
#   lexical   (deterministic, no deps)
#   embedding (sentence-transformers cosine; needs the gpu extra)
#   nli       (cross-encoder entailment P(passage ⊨ claim); needs the gpu extra)
# The semantic options fall back to lexical if their deps are missing.
LRG_SUPPORT_SCORER=nli
# LRG_SUPPORT_THRESHOLD=0.55
LRG_NLI_MODEL=cross-encoder/nli-deberta-v3-base
# On the Spark, for real semantic verification:
#   LRG_SUPPORT_SCORER=nli
#   LRG_RETRIEVER_MODE=faiss

# PDF renderer: "html" (deterministic HTML/PDF) or "latex" (tectonic/latexmk).
LRG_PDF_RENDERER=html

# Citation style: bluebook | alwd | oscola
LRG_CITATION_STYLE=bluebook

# Long-form manuscript targets (total paper words).
LRG_MANUSCRIPT_TARGET_MIN_WORDS=7500
LRG_MANUSCRIPT_TARGET_MAX_WORDS=10000
# Approximate words per drafted paragraph and hard section cap.
LRG_DRAFT_PARAGRAPH_TARGET_WORDS=220
LRG_DRAFT_MAX_PARAGRAPHS_PER_SECTION=30
